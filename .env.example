# Discord Bot Token (dari Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Client ID bot kamu (dari Discord Developer Portal → General Information)
CLIENT_ID=your_client_id_here

# FlaviBot User ID (klik kanan FlaviBot di server → Copy User ID)
FLAVIBOT_ID=your_flavibot_id_here

# Guild/Server ID (opsional, untuk deploy instan per guild)
GUILD_ID=your_guild_id_here
